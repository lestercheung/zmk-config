//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
       

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NAV   1
#define PTR   2
#define MEDIA 3
#define NUM   4
#define SYM   5
#define FUN   6

&mt {
  quick-tap-ms = <100>;
  global-quick-tap;
  flavor = "tap-preferred";
  tapping-term-ms = <170>;
};

/ {
     combos {
            compatible = "zmk,combos";
            combo_esc {
                timeout-ms = <50>;
                key-positions = <0 1>;
                bindings = <&kp ESC>;
            };
            /* combo_tvp { */
            /*     timeout-ms = <100>; */
            /*     key-positions = <11 12 13>; */
            /*     bindings = <&tog TVP1>; */
            /* }; */
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp N2>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp G &kp I &kp F>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
            label= "BASE"                  ;
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
//             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
//             ┃     Q     ┃     W     ┃     E     ┃     R     ┃     T     ┃   ┃     Y     ┃     U     ┃     I     ┃     O     ┃     P     ┃
//             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
//             ┃     A     ┃     S     ┃     D     ┃     F     ┃     G     ┃   ┃     H     ┃     J     ┃     K     ┃     L     ┃     '     ┃
// ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
// ┃    ESC    ┃     Z     ┃     X     ┃     C     ┃     V     ┃     B     ┃   ┃     N     ┃     M     ┃     ,     ┃     .     ┃     /     ┃     \     ┃
// ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
//                                     ┃    ESC    ┃    SPC    ┃    TAB    ┃   ┃   ENTER   ┃    SPC    ┃   BSPC    ┃
//                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            bindings = <
// ╷           ╷           ╷           ╷           ╷           ╷           ╷   ╷           ╷           ╷           ╷           ╷           ╷           ╷
                &kp Q       &kp W       &kp E       &kp R       &kp T           &kp Y       &kp U       &kp I       &kp O       &kp P
                &mt LGUI A  &mt LALT S  &mt LCTRL D &mt LSHFT F &kp G           &kp H       &mt RSHFT J &mt RCTRL K &mt RALT L  &mt RGUI SQT
    &kp ESC     &kp Z       &kp X       &kp C       &kp V       &kp B           &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp BSLH
                                    &lt MEDIA ESC &lt NAV SPACE &lt PTR TAB     &lt SYM RET &lt NUM SPACE &lt FUN BSPC
            >;
        };

        nav_layer {
            label = "NAV";
            bindings = <
// ╷           ╷           ╷           ╷           ╷           ╷           ╷   ╷           ╷           ╷           ╷           ╷           ╷           ╷
                &kp ESC     &bt BT_CLR  &kp UP      &kp PG_UP   &none           &kp CARET   &kp AMPS    &kp LPAR    &kp RPAR    &kp MINUS
                &none       &kp LEFT    &kp DOWN    &kp RIGHT   &none           &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &kp COLON
    &tog NAV    &none       &kp HOME    &kp PG_DN   &kp END     &none           &kp AMPS    &kp PG_DN   &kp PG_UP   &kp STAR    &kp PLUS    &kp PIPE
                                        &trans      &trans      &trans          &trans      &kp UNDER   &kp DEL
            >;
        };

        ptr_layer {
            label = "PTR";
            bindings = <
// ╷           ╷           ╷           ╷           ╷           ╷           ╷   ╷           ╷           ╷           ╷           ╷           ╷           ╷
                &trans      &trans     &msc SCRL_UP &trans      &trans          &trans      &trans      &trans      &trans      &kp UNDER
                &trans &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_RIGHT &trans     &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT   &kp SEMI
    &tog PTR    &trans      &trans      &trans      &trans      &trans      &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &trans      &trans
                                        &trans      &trans      &trans          &mkp RCLK   &mkp LCLK   &mkp MCLK
            >;
        };
        media_layer {
            label = "MEDIA";
            bindings = <
// ╷           ╷           ╷           ╷           ╷           ╷           ╷   ╷           ╷           ╷           ╷           ╷           ╷           ╷
                &trans      &trans     &kp C_VOL_UP &kp C_MUTE  &trans          &trans    &kp C_BRI_DN &kp C_BRI_UP &trans      &trans
                &trans      &kp C_PREV &kp C_VOL_DN &kp C_NEXT  &trans          &trans    &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV  &kp C_NEXT
    &trans      &trans      &trans      &kp C_PP    &trans      &trans          &trans    &kp C_MUTE    &trans      &trans      &trans      &trans
                                        &trans      &trans      &trans          &trans      &trans      &trans
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
// ╷           ╷           ╷           ╷           ╷           ╷           ╷   ╷           ╷           ╷           ╷           ╷           ╷           ╷
                &kp EXCL    &kp N7      &kp N8      &kp N9      &kp PRCNT       &kp PG_UP   &bt BT_NXT  &bt BT_PRV  &bt BT_CLR  &kp BSPC
                &kp AT      &kp N4      &kp N5      &kp N6      &kp PLUS        &kp PG_DN &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3
    &kp GRAVE   &kp TILDE   &kp N1      &kp N2      &kp N3      &kp MINUS       &trans      &trans      &trans      &trans      &kp EQUAL   &bt BT_CLR_ALL
                                        &kp N0      &kp STAR    &kp EQUAL       &trans      &trans      &trans
            >;
        };

        symbols_layer {
            label = "SYM";
            bindings = <
// ╷           ╷           ╷           ╷           ╷           ╷           ╷   ╷           ╷           ╷           ╷           ╷           ╷           ╷
                &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT       &trans      &trans      &trans      &trans      &trans
                &kp AMPS    &kp BSLH    &kp LPAR    &kp RPAR    &kp PIPE        &trans      &trans      &trans      &trans      &trans
    &trans      &kp GRAVE   &kp CARET   &kp LBKT    &kp RBKT    &kp BSLH        &trans      &trans      &trans      &trans      &trans      &trans
                                        &kp LT      &kp GT      &kp EQUAL       &trans      &trans      &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
// ╷           ╷           ╷           ╷           ╷           ╷           ╷   ╷           ╷           ╷           ╷           ╷           ╷           ╷
                &kp F10     &kp F7      &kp F8      &kp F9      &kp F10         &trans      &trans      &trans      &trans      &trans
                &kp F11     &kp F4      &kp F5      &kp F6      &kp F11         &trans      &trans      &trans      &trans      &trans
    &trans      &kp F12     &kp F1      &kp F2      &kp F3      &kp F12         &trans      &trans      &trans      &trans      &trans      &trans
                                        &trans      &trans      &trans          &trans      &trans      &trans
            >;
        };

    };  // keymap
};
